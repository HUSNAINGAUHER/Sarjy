# Sessions & memory (docker-compose: postgres + redis)
DATABASE_URL=postgresql://sarjy:sarjy@localhost:5433/sarjy
REDIS_URL=redis://localhost:6379

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Override to nova-2 if your Deepgram plan doesn't include Flux (flux-general-en)
DEEPGRAM_STT_MODEL=flux-general-en

# TTS provider. Deepgram is current default; use cartesia to compare streaming quality.
VOICE_TTS_PROVIDER=deepgram
# CARTESIA_API_KEY=your_cartesia_api_key_here
# CARTESIA_TTS_MODEL=sonic-2
# CARTESIA_TTS_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238
# Optional: different Cartesia library voices per personality (default: CARTESIA_TTS_VOICE_ID).
# Emotion (happy / excited / melancholic / sarcastic) is applied per persona for Sonic-3+ models.
# CARTESIA_VOICE_JOLLY=
# CARTESIA_VOICE_ENERGETIC=
# CARTESIA_VOICE_SAD=
# CARTESIA_VOICE_SARCASTIC=

# Voice LLM — text only (STT transcript → streamText → TTS). Default: Google Gemini.
VOICE_LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here
# Text chat models only (not *-native-audio* / *-tts*). Examples: gemini-2.0-flash, gemini-2.5-flash-lite
VOICE_LLM_MODEL=gemini-2.0-flash

# Optional: OpenAI instead of Gemini
# VOICE_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# VOICE_LLM_MODEL=gpt-4o-mini

# Optional: Groq (model id llama-3.1-8b-instant is Groq’s API, not xAI Grok)
# VOICE_LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# VOICE_LLM_MODEL=llama-3.1-8b-instant

# Optional: cheaper model for summarization + memory extraction (defaults to VOICE_LLM_MODEL)
# VOICE_MEMORY_LLM_MODEL=gemini-2.0-flash

# Per voice Socket.io session: append-only latency journey log (default on; set false to disable).
# VOICE_SESSION_JOURNEY_LOG_ENABLED=true
# VOICE_SESSION_JOURNEY_LOG_DIR=/absolute/or/relative/path/to/logs
